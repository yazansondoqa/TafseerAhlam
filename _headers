# ================================================================
# رؤوس HTTP — تُطبَّق تلقائياً على كل الصفحات عند النشر على Cloudflare Pages
# ================================================================

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# ملف ads.txt — يجب أن يُقدَّم كنص عادي دون تخزين مؤقت
/ads.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

# ملف robots.txt
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

# الأصول الثابتة — تخزين طويل
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# CSS — تحقق دائم حتى تظهر التعديلات
/css/*
  Cache-Control: public, max-age=0, must-revalidate

# JS — تحقق دائم حتى تظهر التعديلات
/js/*
  Cache-Control: public, max-age=0, must-revalidate
